{
  "name": "@oxform/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "pnpm run playground:build && vp dev",
    "build": "pnpm run playground:build && vp build",
    "playground:build": "vp run example-oxform-react#build && vp run example-oxform-solid#build && vp run example-oxform-solid-v2#build",
    "start": "node .output/server/index.mjs",
    "check:types": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@frantss/fumadocs-theme": "0.1.1",
    "@oxform/core": "workspace:*",
    "@oxform/react": "workspace:*",
    "@oxform/solid": "workspace:*",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-twoslash": "4.0.1",
    "fumadocs-typescript": "5.4.1",
    "fumadocs-ui": "16.17.8",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "example-oxform-react": "workspace:*",
    "example-oxform-solid": "workspace:*",
    "example-oxform-solid-v2": "workspace:*",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  }
}
