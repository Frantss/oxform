{
  "name": "@oxform/solid",
  "version": "0.2.0",
  "description": "Solid bindings for Oxform.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "default": "./dist/v2/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run @oxform/solid-v1#build && vp run @oxform/solid-v2#build && node scripts/assemble.ts",
    "test": "vp run @oxform/solid-v1#test && vp run @oxform/solid-v2#test",
    "check:types": "vp exec tsc --noEmit",
    "check:package": "publint --strict && attw --pack --no-emoji --profile esm-only && pnpm run check:consumers",
    "check:consumers": "node scripts/check-consumers.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@oxform/core": "workspace:*",
    "@oxform/solid-v1": "workspace:*",
    "@oxform/solid-v2": "workspace:*",
    "@solidjs/web": "2.0.0-rc.19",
    "@types/node": "26.6.5",
    "publint": "^0.3.25",
    "solid-js": "2.0.0-rc.19",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@oxform/core": "workspace:^",
    "@solidjs/web": "2.0.0-rc.19",
    "solid-js": "^1.9.0 || 2.0.0-rc.19"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    }
  }
}
