{
  "name": "oxform-solid",
  "version": "0.1.0",
  "description": "Solid bindings for Oxform.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "v2": [
        "./dist/v2/index.d.ts"
      ]
    }
  },
  "imports": {
    "#*": "./export/*.ts"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./v2": {
      "import": {
        "types": "./dist/v2/index.d.ts",
        "default": "./dist/v2/index.js"
      },
      "require": {
        "types": "./dist/v2/index.d.cts",
        "default": "./dist/v2/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp run @oxform/solid-v1#build && vp run @oxform/solid-v2#build && node scripts/assemble.ts",
    "test": "vp run @oxform/solid-v1#test && vp run @oxform/solid-v2#test",
    "test:dev": "vp run -r --filter '@oxform/solid-*' --parallel test:dev",
    "test:ssr": "vp run @oxform/solid-v1#test:ssr && vp run @oxform/solid-v2#test:ssr",
    "check:types": "vp exec tsc --noEmit",
    "check:package": "publint --strict && attw --pack --no-emoji && node scripts/check-consumers.ts",
    "check:consumers": "node scripts/check-consumers.ts"
  },
  "dependencies": {
    "oxform-core": "workspace:*",
    "remeda": "^2.50.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@oxform/solid-v1": "workspace:*",
    "@oxform/solid-v2": "workspace:*",
    "@solidjs/web": "2.0.0-rc.13",
    "@types/node": "26.6.4",
    "publint": "^0.3.25",
    "solid-js": "2.0.0-rc.13",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.13",
    "solid-js": "^1.9.0 || 2.0.0-rc.13"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    }
  }
}
