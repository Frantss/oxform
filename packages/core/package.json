{
  "name": "@oxform/core",
  "version": "0.6.0",
  "description": "Oxform is a lean and flexible framework-agnostic form library.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core": "./export/index.ts",
    "#core/behaviors": "./export/behaviors.ts",
    "#core/presets": "./export/presets.ts",
    "#core/adapter": "./export/adapter.ts",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./behaviors": {
      "types": "./dist/behaviors.d.ts",
      "default": "./dist/behaviors.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit",
    "check:package": "publint --strict && attw --pack --no-emoji --profile esm-only && pnpm run test:package",
    "test:package": "vp test --project package",
    "check:tree-shaking": "cd tests/bundle && vp pack && cd ../.. && node scripts/check-tree-shaking.ts",
    "report:size": "cd tests/bundle && vp pack && cd ../.. && node scripts/measure-bundles.ts"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/store": "^0.11.2",
    "remeda": "^2.54.1",
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "26.6.5",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
