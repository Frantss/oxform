{
  "name": "@oxform/core",
  "version": "0.5.0",
  "description": "Oxform is a lean and flexible framework-agnostic form library.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "test:dev": "vp test --watch",
    "check:test-duplicates": "node scripts/check-test-duplicates.ts",
    "check:test-structure": "node scripts/check-test-structure.ts",
    "check:types": "vp exec tsc --noEmit",
    "check:package": "pnpm run check:test-duplicates && pnpm run check:test-structure && publint --strict && attw --pack --no-emoji"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/store": "^0.11.2",
    "remeda": "^2.50.0",
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
