{
  "name": "@oxform/core",
  "version": "0.7.0",
  "description": "Oxform is a lean and flexible framework-agnostic form library.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#core": "./export/index.ts",
    "#core/behaviors": "./export/behaviors.ts",
    "#core/presets": "./export/presets.ts",
    "#core/adapter": "./export/adapter.ts",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./behaviors": {
      "types": "./dist/behaviors.d.ts",
      "default": "./dist/behaviors.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test --project unit --project integration",
    "test:coverage": "vp test --project unit --coverage.enabled",
    "test:dev": "vp test --project unit --project integration --watch",
    "check:types": "vp exec tsc --noEmit && vp exec tsc --noEmit -p scripts && vp exec tsc --noEmit -p tests/types",
    "check:types:dist": "vp exec tsc --noEmit -p tests/types/tsconfig.dist.json",
    "check:type-coverage": "node scripts/check-type-coverage.ts",
    "check:package": "publint --strict && attw --pack --no-emoji --profile esm-only && pnpm run check:types:dist && pnpm run check:type-coverage"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/store": "^0.11.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "26.6.5",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
