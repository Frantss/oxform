{
  "name": "@oxform/solid-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Solid bindings for Oxform.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "imports": {
    "#hydration-fixture": "./src/tests/fixtures/hydration.tsx",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "pnpm run test:ssr && vp test",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit",
    "test:ssr": "vp test --config vite.ssr.config.ts"
  },
  "dependencies": {
    "@oxform/core": "workspace:*",
    "remeda": "^2.54.1"
  },
  "devDependencies": {
    "@solidjs/compiler": "2.0.0-rc.19",
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "@solidjs/web": "2.0.0-rc.19",
    "@types/node": "26.6.5",
    "solid-js": "2.0.0-rc.19",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
