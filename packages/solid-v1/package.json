{
  "name": "@oxform/solid-v1",
  "version": "0.1.0",
  "private": true,
  "description": "Solid bindings for Oxform.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test && vp test --config vite.ssr.config.ts",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit && vp exec tsc --noEmit -p tests/types",
    "test:ssr": "vp test --config vite.ssr.config.ts",
    "check:types:dist": "vp exec tsc --noEmit -p tests/types/tsconfig.dist.json",
    "check:type-coverage": "node scripts/check-type-coverage.ts"
  },
  "devDependencies": {
    "@oxform/adapter-parity": "workspace:*",
    "@oxform/core": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "@oxform/core": "workspace:^"
  }
}
