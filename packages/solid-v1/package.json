{
  "name": "@oxform/solid-v1",
  "version": "0.1.0",
  "private": true,
  "description": "Solid bindings for Oxform.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit",
    "test:ssr": "vp test --config vite.ssr.config.ts"
  },
  "dependencies": {
    "@oxform/core": "workspace:*"
  },
  "devDependencies": {
    "solid-js": "^1.9.15",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.14",
    "zod": "^4.6.5"
  }
}
