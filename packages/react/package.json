{
  "name": "@oxform/react",
  "version": "0.7.0",
  "description": "Oxform is a lean and flexible framework-agnostic form library.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test && vp test --config vite.ssr.config.ts",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit && vp exec tsc --noEmit -p tests/types",
    "check:package": "publint --strict && attw --pack --no-emoji --profile esm-only && pnpm run check:types:dist && pnpm run check:type-coverage && pnpm run check:client-directive",
    "test:ssr": "vp test --config vite.ssr.config.ts",
    "check:types:dist": "vp exec tsc --noEmit -p tests/types/tsconfig.dist.json",
    "check:type-coverage": "node scripts/check-type-coverage.ts",
    "check:client-directive": "node scripts/check-client-directive.ts"
  },
  "dependencies": {
    "@tanstack/react-store": "^0.11.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@oxform/adapter-parity": "workspace:*",
    "@oxform/core": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "publint": "^0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@oxform/core": "workspace:^",
    "react": "^19.0.0"
  }
}
