{
  "name": "@oxform/react",
  "version": "0.5.1",
  "description": "Oxform is a lean and flexible framework-agnostic form library.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "imports": {
    "#array-field": "./src/array-field.tsx",
    "#field": "./src/field.tsx",
    "#subscribe": "./src/subscribe.tsx",
    "#use-form-effect": "./src/use-form-effect.ts",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit",
    "check:package": "publint --strict && attw --pack --no-emoji"
  },
  "dependencies": {
    "@oxform/core": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-store": "^0.11.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^7.0.2",
    "vitest-browser-react": "^2.3.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
